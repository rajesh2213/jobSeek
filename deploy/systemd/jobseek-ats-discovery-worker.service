[Unit]
Description=JobSeek ATS Discovery Worker
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/jobSeek
EnvironmentFile=/home/ubuntu/jobSeek/.env
ExecStart=/usr/bin/npm run worker:ats-discovery -w @jobseek/server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
