[Unit]
Description=JobSeek Discovery Scheduler
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/jobSeek
EnvironmentFile=/home/ubuntu/jobSeek/.env
Environment=WORKER_NAME=jobseek-discovery-scheduler
ExecStart=/usr/bin/npm run discovery:scheduler -w @jobseek/server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
