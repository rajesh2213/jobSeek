[Unit]
Description=JobSeek OpenClaw Scheduler (enqueue sync)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/jobSeek
EnvironmentFile=/home/ubuntu/jobSeek/.env
Environment=WORKER_NAME=jobseek-openclaw-scheduler
ExecStart=/usr/bin/npm run scheduler:openclaw -w @jobseek/server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
