[Unit]
Description=JobSeek ATS Discovery Scheduler
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/jobSeek
EnvironmentFile=/home/ubuntu/jobSeek/.env
Environment=WORKER_NAME=jobseek-ats-discovery-scheduler
ExecStart=/usr/bin/npm run scheduler:ats-discovery -w @jobseek/server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
