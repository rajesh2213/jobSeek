[Unit]
Description=JobSeek Discovery Worker
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/jobSeek
EnvironmentFile=/home/ubuntu/jobSeek/.env
Environment=WORKER_NAME=jobseek-discovery-worker
ExecStart=/usr/bin/npm run discovery:worker -w @jobseek/server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
