[Unit]
Description=JobSeek Enrich Worker
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/jobSeek
Environment=WORKER_NAME=jobseek-enrich
ExecStart=/usr/bin/npm run worker:enrich -w @jobseek/server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
