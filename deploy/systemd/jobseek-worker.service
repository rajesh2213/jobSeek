[Unit]
Description=JobSeek Worker
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/jobSeek
EnvironmentFile=/home/ubuntu/jobSeek/.env
Environment=WORKER_NAME=jobseek-worker
ExecStart=/usr/bin/npm run worker -w @jobseek/server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
