[Unit]
Description=JobSeek ATS Endpoint Scheduler
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/jobSeek
ExecStart=/usr/bin/npm run scheduler:ats-endpoint -w @jobseek/server
Restart=always
Environment=NODE_ENV=production
Environment=WORKER_NAME=jobseek-ats-scheduler

[Install]
WantedBy=multi-user.target
