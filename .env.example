# Database (used by apps/server)
# IMPORTANT: Total DB connections ≈ connection_limit × number_of_Prisma_processes.
# For Supabase Nano (~15), keep total ≤ 12; leave headroom (e.g. 3 processes × 4 = 12).
# With pgbouncer, use statement_cache_size=0 to avoid prepared-statement errors.
# DATABASE_URL=postgresql://...?connection_limit=4&pgbouncer=true&statement_cache_size=0
DATABASE_URL=postgresql://jobseek:jobseek@localhost:15432/jobseek
# Direct Postgres (no pooler) for Prisma migrate / db push. On Supabase, use the "Direct connection" string (port 5432). Locally, usually the same as DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://jobseek:jobseek@localhost:15432/jobseek

# Redis (used by apps/server for future queue use)
REDIS_URL=redis://localhost:6379

# Bull workers + ATS ingestion (throughput; tune for pool size and parser capacity)
# WORKER_CONCURRENCY=5
# ENRICH_COMPANY_WORKER_CONCURRENCY=3
# ATS_POOL_INGEST_CONCURRENCY=3
# Ingest is capped: min(ATS_POOL_INGEST_CONCURRENCY, ATS_PARSE_CONCURRENCY) in ats-endpoint worker
# ATS_PARSE_CONCURRENCY=3
# ATS_PARSE_CHUNK_SIZE=50
# ATS_ENDPOINT_WORKER_CONCURRENCY=1
# Optional: 2 on a larger VPS reduces starvation if one ingest is slow (monitor CPU/Workday rate limits).
# Hard cap on adapter fetch (fetch+normalize); on expiry job fails with UnrecoverableError (no Bull retries). 0=disable.
# ATS_ENDPOINT_FETCH_TIMEOUT_MS=600000
# Workday: max listing pages per token (20 jobs/page); stops runaway pagination.
# WORKDAY_LISTING_MAX_PAGES=2000
# Workday: wall-clock cap per token loop and overall host/site sweep (ms).
# WORKDAY_FETCH_MAX_MS=600000
# Heartbeat: warn when an ingest is active longer than this (ms).
# ATS_HEARTBEAT_ACTIVE_WARN_MS=300000
# Heartbeat: with active job slow, also emit starvation risk when wait queue is at least this deep.
# ATS_HEARTBEAT_QUEUE_WAIT_WARN=40
# PROCESS_JOB_ADD_CHUNK_SIZE=50
# Skip enqueue when sourceUrl was seen recently (Redis key: job:seen:{sourceUrl}); default 6h.
# PROCESS_JOB_RECENT_SEEN_TTL_SEC=86400
# MAX_IN_FLIGHT_PARSE=6
# Tuning: try 4 → 5 → 6; revert if `ai_parse_latency` p95 rises with flat load
# Short burst window (s): marker + v1 read skip duplicate HTTP. 0 = off. Not the long-term PARSE cache.
# PARSE_BURST_DEDUPE_TTL_SEC=0
# PARSE_BURST_DEDUPE_TTL_SEC=1200
# MAX_MERGED_SKILLS=60
# PARSE_CACHE_TTL_SEC=86400
# PARSE_CACHE_ENABLED=1
# Scripts: find / requeue jobs missing parsedDescription (1–500; default 50)
# REQUEUE_MISSING_PARSED_LIMIT=50
# FIND_JOBS_MISSING_PARSED_LIMIT=50

# Server
PORT=3000
# Fastify trustProxy is always enabled in code (nginx / X-Forwarded-For).
# Global @fastify/rate-limit uses Redis when REDIS_URL is set (shared across instances); otherwise in-memory.

# Inference HTTP: same timeout for Axios POST /parse (ai.service) and fetch POST /resume/embed (resumeEmbedder).
# Default 120000 ms if unset or invalid.
# AI_JOB_PARSER_TIMEOUT_MS=120000

# Kubernetes-style readiness: register GET /health/ready (DB + Redis ping). Default off; does not change GET /health.
# ENABLE_READINESS_PROBE=true

# Observability (optional): log when Prisma queries or /jobs HTTP routes exceed threshold (ms)
# PRISMA_SLOW_QUERY_MS=200
# LOG_SLOW_ROUTE_MS=150
# Enrichment: INFO log for each domain_resolution_outcome (debug always emits structured event)
# LOG_DOMAIN_RESOLUTION=1
# apps/server: rotated log retention (days); purge + rotating-file-stream maxFiles. Default 3.
# LOG_RETENTION_DAYS=3
# monitor:pipeline + runSmokeTest15m cumulative journalctl --since (default 10 min). Set e.g. 15 min ago to align a 15m smoke run
# MONITOR_PIPELINE_JOURNAL_SINCE=10 min ago
# runSmokeTest15m per-tick journal sample window (default 5 min)
# SMOKE_JOURNAL_TICK_SINCE=5 min ago
# runSmokeTest15m: number of 1m samples (default 15). E.g. 10 for ten check-ins
# SMOKE_TEST_TICKS=10
# SMOKE_TEST_INTERVAL_SEC=60
# apps/server: seed:csv only — slice data rows: skip N then take at most M (after skip)
# CSV_SEED_SKIP_DATA_ROWS=0
# CSV_SEED_MAX_ROWS=250
# If enrichQueue.close() stalls (Redis), cap wait so seed exits before smoke (ms)
# CSV_ENRICH_QUEUE_CLOSE_TIMEOUT_MS=10000
# If Prisma disconnect hangs, cap wait (ms)
# CSV_PRISMA_DISCONNECT_TIMEOUT_MS=15000
# Exit 3 when inserted+fallbackInserted===0 so `seed:csv && smoke` does not run on an all-duplicate file
# CSV_SEED_FAIL_IF_NO_NEW=1

# Integration tests: job discovery Prisma vs SQL parity (apps/server npm run test:integration)
# JOB_DISCOVERY_PARITY_TEST=1
# JOB_DISCOVERY_EXPLAIN=1

# Dev-only (ignored when NODE_ENV=production): force Pro or Free for testing without Lemon Squeezy.
# Match by real email (not @users.clerk.local) and/or Clerk user id (Dashboard → Users → copy id).
# If you use multiple test logins, list every Clerk User ID you use, comma-separated.
# DEV_PLAN_OVERRIDE_ENABLED=true
# DEV_PLAN_OVERRIDE_EMAILS=you@gmail.com
# DEV_PLAN_OVERRIDE_CLERK_IDS=user_aaa,user_bbb
# DEV_PLAN_OVERRIDE=pro|free
# DEV_SMART_APPLY_EXTRACT_BYPASS_DAILY_LIMIT=true
# DEV_EXTENSION_AUTH_BYPASS=true
# Then you can use extension authToken: dev:user_xxx (non-expiring local dev token)

# Anthropic (Smart Apply AI answers on server)
ANTHROPIC_API_KEY=sk-ant-...

# Resume object storage (Cloudflare R2, S3-compatible)
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_BUCKET=jobseek-resumes
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Optional tuning
# RESUME_BACKFILL_BATCH_SIZE=100

# Job expiry/purge safety controls
# JOB_PURGE_DRY_RUN=true
# JOB_PURGE_BATCH_SIZE=1000
# JOB_PURGE_MAX_ROWS_PER_RUN=5000

# SERP cost controls
# Hard monthly cap on SERP queries (counts SerpBatch rows in current UTC month). Unset = no cap.
# SERP_MONTHLY_BUDGET=250
# Override max queries executed per scheduler run (default 8; debug mode default 3).
# SERP_MAX_QUERIES_PER_RUN=8
# Optional: debug mode uses reduced query set.
# SERP_MODE=debug

# Optional: Remote Rocketship / OpenClaw (supplemental jobs + discovery; NOT primary inventory).
# Workers: `npm run worker:openclaw` + `npm run scheduler:openclaw` — see apps/server/docs/runbooks/openclaw.md
# When OPENCLAW_ENABLED=false, behavior matches a build without OpenClaw.
# OPENCLAW_ENABLED=false
# OPENCLAW_API_KEY=
# Same key as OpenClaw gateway skill; used if OPENCLAW_API_KEY is unset.
# RR_API_KEY=
# OPENCLAW_BASE_URL=https://www.remoterocketship.com
# OPENCLAW_API_PATH=/api/openclaw/jobs
# OPENCLAW_TIMEOUT_MS=8000
# OPENCLAW_MAX_REQUESTS_PER_DAY=900
# OPENCLAW_QUOTA_RESERVE=100
# OPENCLAW_SYNC_ENABLED=false
# OPENCLAW_DISCOVERY_ENABLED=true
# OPENCLAW_ENRICHMENT_ENABLED=true
# OPENCLAW_DRY_RUN=true
# When true: zero Postgres writes from OpenClaw (synthetic company ids + no discovery/enrich/merge).
# Redis metrics, quota, and paging keys still update. Dedup sim uses read-only job lookups by URL.
# OPENCLAW_CACHE_TTL_SEC=300
# OPENCLAW_SYNC_INTERVAL_MS=14400000
# OPENCLAW_ITEMS_PER_PAGE=40
# OPENCLAW_MAX_PAGES_PER_RUN=3
# OPENCLAW_CIRCUIT_FAILURE_THRESHOLD=5
# OPENCLAW_CIRCUIT_COOLDOWN_MS=300000
# OPENCLAW_HTTP_RETRIES=2

# PayPal subscriptions (server-side only; client calls backend route)
# PAYPAL_MODE=sandbox
# ALLOW_PAYPAL_SANDBOX_IN_PRODUCTION=false
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# Subscription approval redirects (HTTPS in production / live mode — avoids generic PayPal “Try Again”).
# Optional if CLIENT_URL or NEXT_PUBLIC_SITE_URL is set (defaults: {origin}/pricing?paypal=return|cancel).
# PAYPAL_CHECKOUT_ORIGIN=https://your-domain.com
# PAYPAL_RETURN_URL=https://your-domain.com/pricing?paypal=return
# PAYPAL_CANCEL_URL=https://your-domain.com/pricing?paypal=cancel
# PAYPAL_PLAN_ID_MONTHLY=
# PAYPAL_PLAN_ID_YEARLY=
# PAYPAL_WEBHOOK_ID=
# Rare approval-page failures: try IMMEDIATE_PAYMENT_REQUIRED (default is UNRESTRICTED).
# PAYPAL_PAYEE_PREFERRED=IMMEDIATE_PAYMENT_REQUIRED
# PAYPAL_BILLING_VERBOSE_LOGS=false
# PAYPAL_PAST_DUE_GRACE_DAYS=3

# Dodo Payments (card / second billing provider; server + webhook)
# DODO_PAYMENTS_API_KEY=
# Webhook signing secret (Dashboard → Developer → Webhooks). Required to verify POST /billing/dodo/webhook.
# DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode (default) or live_mode — matches checkout API host.
# DODO_PAYMENTS_ENVIRONMENT=test_mode
# Subscription products from Dodo dashboard (monthly / yearly Pro).
# DODO_PRODUCT_ID_MONTHLY=
# DODO_PRODUCT_ID_YEARLY=
# Optional overrides (else derived from CLIENT_URL / NEXT_PUBLIC_SITE_URL like PayPal).
# DODO_CHECKOUT_RETURN_URL=https://your-domain.com/pricing?dodo=return
# DODO_CHECKOUT_CANCEL_URL=https://your-domain.com/pricing?dodo=cancel
# Client inline SDK (apps/client): test | live
# NEXT_PUBLIC_DODO_PAYMENTS_MODE=test

# Landing marketing (Next.js client)
# Hero “Jobs indexed” number (default 2_300_000 if unset/invalid)
# NEXT_PUBLIC_LANDING_HERO_JOB_COUNT=2300000
# Jobs hero strip: override live weekly posted-jobs count (server fetches `posted=1w` when unset)
# JOBS_WEEKLY_POSTED_OVERRIDE=4800
# Extra homepage band: product-capability carousel (not user testimonials; default off)
# NEXT_PUBLIC_SHOW_LANDING_TESTIMONIALS=false

# Public site / legal (Next.js client — footers, Terms, Privacy)
# Copy apps/client/.env.example → apps/client/.env.local and fill in (Next loads that folder’s `.env*`).
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_COMPANY_LEGAL_NAME=
# NEXT_PUBLIC_COMPANY_ADDRESS=
# NEXT_PUBLIC_GOVERNING_LAW_JURISDICTION=

# Clerk backend verification (repo root `.env`; apps/server loads this via loadRootEnv).
# Must match the Clerk application used by Next.js (`NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY` in apps/client/.env.local).
# Mirror the publishable key here too so Fastify can bind JWT `iss` ↔ Frontend API host on non-.dev Clerk domains:
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# Optional PEM “JWT public key” from Clerk Dashboard for networkless verify.
# CLERK_JWT_KEY=
# Production (`NODE_ENV=production`): session JWT `azp` must match — set CLIENT_URL / NEXT_PUBLIC_SITE_URL and/or:
# CLERK_AUTHORIZED_PARTIES=http://localhost:3001,https://jobloom.tech
# Non-production: signature/JWKS verification only (avoids brittle localhost/https/port/azp mismatches during dev).
# If you must run the API with NODE_ENV=production locally, temporarily relax azp checks:
# JOBLOOM_RELAX_CLERK_AZP=true
# Include auth diagnostics in `/account/*` 401 JSON even when NODE_ENV=production (avoid in real prod):
# JOBLOOM_AUTH_DEBUG_RESPONSES=true
# If JWT verification fails with TokenIatInTheFuture (API host clock behind Clerk), widen skew (ms; default 180000, max 600000):
# CLERK_JWT_CLOCK_SKEW_MS=300000

# Public URLs (email links, billing redirects)
CLIENT_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3000
# Production example: API_PUBLIC_URL=https://api.jobloom.tech
# Chrome extension store build (`apps/extension` webpack): use the same public API origin.
# EXTENSION_API_BASE=https://api.jobloom.tech

# Next.js SEO: canonical origin (https in production, no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Thin / duplicate-like listing pages below this match count send noindex (default 5)
NEXT_PUBLIC_SEO_MIN_JOBS_INDEX=5
# Deterministic SEO policy flags (Next.js metadata + sitemap)
# SEO_INDEX_MATRIX_ENABLED=false
# SEO_SITEMAP_PRUNING_ENABLED=false
# SEO_COMPANY_QUALITY_GATE_ENABLED=false
# Bounded sitemap regeneration/caps (stability-first defaults)
# SEO_SITEMAP_REVALIDATE_SECONDS=300
# SEO_SITEMAP_MAX_JOB_PAGES=200
# SEO_SITEMAP_JOB_FETCH_LIMIT=100
# SEO_SITEMAP_MAX_COMPANY_PAGES=100
# SEO_SITEMAP_MAX_LANDING_SLUGS=1500
# SEO_SITEMAP_LANDING_MIN_COUNT=5
# /seo/landing-pages generation guardrails
# SEO_LANDING_DEFAULT_MAX_SLUGS=1500
# SEO_LANDING_ABSOLUTE_MAX_SLUGS=3000
# SEO_LANDING_MAX_ROLE_SLUGS=20
# SEO_LANDING_MAX_LOCATION_DIMENSIONS=8
# SEO_LANDING_MAX_EXPERIENCE_DIMENSIONS=2
# Emergency rollback toggles
# SEO_DISABLE_ALL_NOINDEX=false
# SEO_FORCE_NOINDEX_ALL=false
# Server-only shared secret (Fastify + Next server) for internal SEO bypass headers:
# x-internal-seo: true + x-internal-seo-secret: <INTERNAL_SEO_SECRET>
INTERNAL_SEO_SECRET=super_secure_random_value
# Backward-compatible legacy token (deprecated)
JOB_LIST_VIEW_CAP_BYPASS_TOKEN=random-string-here
# Unified cap behavior (Fastify)
CAP_MODE=soft
FREE_TIER_DAILY_LIMIT=75
# When 1, API logs structured timings for canonical job listing (raw id SQL vs Prisma hydrate vs reorder).
# DEBUG_JOB_LIST_PERF=1
# When set (ms > 0), logs one structured JOB_LIST_SLOW warn per slow listing when total time exceeds threshold (no verbose DEBUG_JOB_LIST_PERF required).
# JOB_LIST_SLOW_THRESHOLD_MS=2500
# When set (ms > 0), logs JOB_LIST_METERED_SLOW when Server-Timing `metered_list` exceeds this (full /jobs handler after cap_ctx). OFF by default.
# JOB_LIST_METERED_SLOW_MS=5000
#
# Prisma SQL diagnostics: logs prisma_query_diag (rate-limited, redacted params). Requires API restart. Pair with JOB_LIST_METERED_SLOW / DEBUG_JOB_LIST_PERF.
# PRISMA_QUERY_DIAG=1
# Max prisma_query_diag lines per rolling minute (default 40).
# PRISMA_QUERY_DIAG_MAX_PER_MIN=40
#
# GET /internal/db/pg-activity — Bearer INTERNAL_DB_DIAG_SECRET or INTERNAL_METRICS_TOKEN; production loopback only. CLI: npm run diag:pg-activity -w @jobseek/server
# INTERNAL_DB_DIAG_SECRET=
# Internal-only: GET /internal/job-list/hydrate-shadow (Bearer secret). Compares baseline vs omit-_count vs trunc-description hydrates; not registered if unset. Production: loopback IP only.
# JOB_LIST_SHADOW_SECRET=
# Default trunc length for shadow HTTP route (override with ?shadowDescChars=). CLI: npm run probe:job-list-shadow -w @jobseek/server
# JOB_LIST_SHADOW_DESC_PREFIX=16000
#
# --- Probe note (2026-05): `npm run probe:job-list-shadow` on a prod-like DB showed:
# - Byte-identical list JSON vs baseline for all tested scenarios at SUBSTRING(..., 2000) (min safe; 1200 broke parity).
# - That SQL+second-query path still INCREASED hydrateMs vs single Prisma findMany (~+50–80ms typical here).
# - Omitting company._count reduced hydrateMs (~15–40ms) but changes openRoles unless merged from elsewhere.
# Do not enable a production desc-prefix hydrate for latency until a single-round-trip or cheaper plan is proven.
# Preview rows shown on page 1 after daily cap is exhausted.
FREE_DISCOVERY_PREVIEW_ROWS=5
# Client-safe mirrors (Next.js)
NEXT_PUBLIC_FREE_TIER_DAILY_LIMIT=75
NEXT_PUBLIC_FREE_DISCOVERY_PREVIEW_ROWS=5
# Set false to disable premium Smart Apply surface rollout.
# NEXT_PUBLIC_SMART_APPLY_PREMIUM_V1=true

# Smart Apply Chrome extension ID (chrome://extensions or Chrome Web Store URL after publish).
# Required for signed-in web → extension auth handshake on allowed origins (jobloom.tech, localhost).
# NEXT_PUBLIC_JOBLOOM_EXTENSION_ID=

# Job alert emails (Resend) + unsubscribe HMAC
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@jobseek.app
JOB_ALERT_HMAC_SECRET=change-me-to-a-long-random-string

# Careers HTML ingestion (apps/server jobSourceUrlIngestion)
# Set to 1 to enable scored validation gate before inserting careers_page jobs.
# CAREERS_JOB_VALIDATION_ENABLED=1
# Optional: only use JSON-LD JobPosting for description text (stricter; fewer rows).
# CAREERS_PAGE_STRICT_DESCRIPTION=1
# After a failed validation, try one alternate HTML extraction (requires CAREERS_JOB_VALIDATION_ENABLED=1).
# CAREERS_JOB_SELF_HEAL=1
