#!/bin/sh
# If present, remove editor/IDE footers and Cursor co-author trailers.
f=$1
[ -f "$f" ] || exit 0
tmp=$(mktemp)
tr -d '\r' < "$f" \
  | sed '/^Made-with: Cursor[[:space:]]*$/d' \
  | sed '/^Co-authored-by: Cursor <cursoragent@cursor\.com>[[:space:]]*$/d' \
  > "$tmp" && mv "$tmp" "$f"
exit 0
