{
  "name": "@jobseek/client",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js frontend for job discovery",
  "scripts": {
    "dev": "node ./scripts/ensure-routes-manifest.cjs && next dev",
    "dev:3001": "node ./scripts/ensure-routes-manifest.cjs && next dev -p 3001",
    "dev:turbo": "node ./scripts/ensure-routes-manifest.cjs && next dev --turbo",
    "build": "cd ../.. && npm run build -w @jobseek/skill-constants && cd apps/client && next build",
    "start": "next start",
    "test:soft": "node --import tsx --test lib/resumeScoreSoftening.test.ts"
  },
  "dependencies": {
    "@jobseek/server": "*",
    "@jobseek/skill-constants": "*",
    "@clerk/backend": "^1.34.0",
    "@clerk/nextjs": "^6.39.1",
    "@tanstack/react-virtual": "^3.13.23",
    "framer-motion": "^12.38.0",
    "next": "^15.3.3",
    "server-only": "^0.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.15.30",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.27",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3"
  }
}
