# Copy to `.env.local` (same folder). Next.js loads `.env.local` automatically — it is gitignored.
# See also repo-root `.env.example` for server/shared vars.

# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_COMPANY_LEGAL_NAME=
# NEXT_PUBLIC_COMPANY_ADDRESS=
# NEXT_PUBLIC_GOVERNING_LAW_JURISDICTION=
# NEXT_PUBLIC_LANDING_HERO_JOB_COUNT=
# Homepage product-highlight carousel (not testimonials). Default off.
# NEXT_PUBLIC_SHOW_LANDING_TESTIMONIALS=false
# Optional server-side override for jobs hero weekly count (otherwise fetched live using posted=1w)
# JOBS_WEEKLY_POSTED_OVERRIDE=
# Canonical site URL for sitemaps and metadata (https in production)
# NEXT_PUBLIC_SITE_URL=http://localhost:3001
# NEXT_PUBLIC_SEO_MIN_JOBS_INDEX=3
# Enable deterministic allowlist-first jobs metadata policy (default off for safe rollout).
# SEO_INDEX_MATRIX_ENABLED=false
# Enable conservative sitemap pruning using shared SEO predicates (default off).
# SEO_SITEMAP_PRUNING_ENABLED=false
# Conservative company gate: only obvious broken states when true.
# SEO_COMPANY_QUALITY_GATE_ENABLED=false
# Bounded sitemap regeneration/caps (stability-first defaults)
# SEO_SITEMAP_REVALIDATE_SECONDS=300
# SEO_SITEMAP_MAX_JOB_PAGES=30
# SEO_SITEMAP_JOB_FETCH_LIMIT=100
# SEO_SITEMAP_MAX_COMPANY_PAGES=100
# SEO_SITEMAP_MAX_LANDING_SLUGS=1500
# SEO_SITEMAP_LANDING_MIN_COUNT=5
# SEO_SITEMAP_LANDING_BUDGET_MS=16000
# SEO_SITEMAP_JOBS_BUDGET_MS=45000
# SEO_SITEMAP_COMPANIES_BUDGET_MS=18000
# /seo/landing-pages generation guardrails (used by API route)
# SEO_LANDING_DEFAULT_MAX_SLUGS=1500
# SEO_LANDING_ABSOLUTE_MAX_SLUGS=3000
# SEO_LANDING_MAX_ROLE_SLUGS=22
# SEO_LANDING_MAX_LOCATION_DIMENSIONS=9
# SEO_LANDING_MAX_EXPERIENCE_DIMENSIONS=2
# Emergency overrides (keep false unless incident response):
# SEO_DISABLE_ALL_NOINDEX=false
# SEO_FORCE_NOINDEX_ALL=false
# Server-only (not NEXT_PUBLIC): must match API INTERNAL_SEO_SECRET for SEO internal bypass.
# INTERNAL_SEO_SECRET=

# Chrome extension ID (NEXT_PUBLIC_* inlined at build). Listing URL + Clerk→extension sync — set on Vercel for Production.
# NEXT_PUBLIC_JOBLOOM_EXTENSION_ID=

# Dodo inline checkout SDK: test | live (must match server DODO_PAYMENTS_ENVIRONMENT)
# NEXT_PUBLIC_DODO_PAYMENTS_MODE=test

# Meta (Facebook) Pixel — public id only; never put the Conversion API token here.
# NEXT_PUBLIC_META_PIXEL_ID=
# Non-production: load pixel only when both ID above is set and this is true
# NEXT_PUBLIC_META_PIXEL_DEBUG=false
# Verbose console logging for Meta client helpers
# NEXT_PUBLIC_META_ANALYTICS_DEBUG=false

# PostHog (optional). Project API key + ingest host (use reverse proxy in production, e.g. https://analytics.jobloom.tech).
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://analytics.jobloom.tech
# Mirror server FREE_RESUME_MATCH_AI_PER_24H for pricing/marketing copy (default 3).
# NEXT_PUBLIC_FREE_RESUME_MATCH_AI_PER_24H=3
