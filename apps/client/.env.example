# Copy to `.env.local` (same folder). Next.js loads `.env.local` automatically — it is gitignored.
# See also repo-root `.env.example` for server/shared vars.

# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_COMPANY_LEGAL_NAME=
# NEXT_PUBLIC_COMPANY_ADDRESS=
# NEXT_PUBLIC_GOVERNING_LAW_JURISDICTION=
# NEXT_PUBLIC_LANDING_HERO_JOB_COUNT=
# Homepage product-highlight carousel (not testimonials). Default off.
# NEXT_PUBLIC_SHOW_LANDING_TESTIMONIALS=false
# Optional server-side override for jobs hero weekly count (otherwise fetched live using posted=1w)
# JOBS_WEEKLY_POSTED_OVERRIDE=
# Canonical site URL for sitemaps and metadata (https in production)
# NEXT_PUBLIC_SITE_URL=http://localhost:3001
# NEXT_PUBLIC_SEO_MIN_JOBS_INDEX=3
# Server-only (not NEXT_PUBLIC): must match API INTERNAL_SEO_SECRET for SEO internal bypass.
# INTERNAL_SEO_SECRET=

# Chrome extension ID (NEXT_PUBLIC_* inlined at build). Listing URL + Clerk→extension sync — set on Vercel for Production.
# NEXT_PUBLIC_JOBLOOM_EXTENSION_ID=

# Dodo inline checkout SDK: test | live (must match server DODO_PAYMENTS_ENVIRONMENT)
# NEXT_PUBLIC_DODO_PAYMENTS_MODE=test

# Meta (Facebook) Pixel — public id only; never put the Conversion API token here.
# NEXT_PUBLIC_META_PIXEL_ID=
# Non-production: load pixel only when both ID above is set and this is true
# NEXT_PUBLIC_META_PIXEL_DEBUG=false
# Verbose console logging for Meta client helpers
# NEXT_PUBLIC_META_ANALYTICS_DEBUG=false
