{
  "manifest_version": 3,
  "name": "JobLoom Smart Apply Assistant",
  "version": "1.0.4",
  "description": "Fill job applications faster with smart autofill and AI-assisted answers on real job application pages.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["activeTab", "storage", "webNavigation", "scripting"],
  "optional_host_permissions": [
    "https://*/apply/*",
    "https://*/careers/*",
    "https://*/jobs/*",
    "https://*/join-us/*"
  ],
  "host_permissions": [
    "https://*.applytojob.com/*",
    "https://*.ashbyhq.com/*",
    "https://*.bamboohr.com/*",
    "https://*.eightfold.ai/*",
    "https://*.greenhouse.io/*",
    "https://*.icims.com/*",
    "https://*.jobs.ashbyhq.com/*",
    "https://*.jobvite.com/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.lever.co/*",
    "https://*.linkedin.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.oraclecloud.com/*",
    "https://*.recruitee.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.successfactors.com/*",
    "https://*.taleo.net/*",
    "https://*.teamtailor.com/*",
    "https://*.workday.com/*",
    "https://jobloom.tech/*",
    "https://api.jobloom.tech/*",
    "https://www.jobloom.tech/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.applytojob.com/*",
        "https://*.ashbyhq.com/*",
        "https://*.bamboohr.com/*",
        "https://*.eightfold.ai/*",
        "https://*.greenhouse.io/*",
        "https://*.icims.com/*",
        "https://*.jobs.ashbyhq.com/*",
        "https://*.jobvite.com/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.lever.co/*",
        "https://*.linkedin.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.oraclecloud.com/*",
        "https://*.recruitee.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.successfactors.com/*",
        "https://*.taleo.net/*",
        "https://*.teamtailor.com/*",
        "https://*.workday.com/*",
        "https://jobloom.tech/*",
        "https://api.jobloom.tech/*",
        "https://www.jobloom.tech/*"
      ],
      "js": ["presenceBeacon.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.applytojob.com/*",
        "https://*.ashbyhq.com/*",
        "https://*.bamboohr.com/*",
        "https://*.eightfold.ai/*",
        "https://*.greenhouse.io/*",
        "https://*.icims.com/*",
        "https://*.jobs.ashbyhq.com/*",
        "https://*.jobvite.com/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.lever.co/*",
        "https://*.linkedin.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.oraclecloud.com/*",
        "https://*.recruitee.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.successfactors.com/*",
        "https://*.taleo.net/*",
        "https://*.teamtailor.com/*",
        "https://*.workday.com/*",
        "https://jobloom.tech/*",
        "https://api.jobloom.tech/*",
        "https://www.jobloom.tech/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "JobLoom",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/logo-prim.png", "assets/icon-16.png", "assets/icon-32.png", "assets/icon-48.png", "assets/icon-128.png"],
      "matches": [
        "https://*.applytojob.com/*",
        "https://*.ashbyhq.com/*",
        "https://*.bamboohr.com/*",
        "https://*.eightfold.ai/*",
        "https://*.greenhouse.io/*",
        "https://*.icims.com/*",
        "https://*.jobs.ashbyhq.com/*",
        "https://*.jobvite.com/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.lever.co/*",
        "https://*.linkedin.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.oraclecloud.com/*",
        "https://*.recruitee.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.successfactors.com/*",
        "https://*.taleo.net/*",
        "https://*.teamtailor.com/*",
        "https://*.workday.com/*",
        "https://jobloom.tech/*",
        "https://api.jobloom.tech/*",
        "https://www.jobloom.tech/*"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://jobloom.tech/*",
      "https://www.jobloom.tech/*",
      "http://localhost:3001/*",
      "http://127.0.0.1:3001/*"
    ]
  }
}
