{
  "name": "@jobseek/extension",
  "version": "1.0.7",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "build:ext": "sh -c 'rm -rf dist && webpack --mode production'",
    "zip:ext": "node scripts/zip-ext.mjs",
    "check:ext": "node scripts/check-ext.mjs",
    "build:analyze": "cross-env ANALYZE=1 webpack --mode production",
    "dev": "webpack --mode development --watch",
    "test:unit": "node --import tsx --test tests/unit/atsDetection.test.ts"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "terser-webpack-plugin": "^5.3.10",
    "cross-env": "^7.0.3",
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.9.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "copy-webpack-plugin": "^12",
    "ts-loader": "^9",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "webpack": "^5",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5"
  },
  "dependencies": {
    "react": "^18",
    "react-dom": "^18"
  }
}
