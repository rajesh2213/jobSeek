{
  "name": "@jobseek/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx tsc",
    "start": "node dist/index.js",
    "worker": "tsx src/workers/job.processor.ts",
    "scheduler": "tsx src/modules/crawler/crawler.scheduler.ts",
    "discovery:worker": "tsx src/workers/discovery.processor.ts",
    "discovery:scheduler": "tsx src/modules/discovery/discovery.scheduler.ts",
    "seed": "tsx scripts/seed.companies.ts",
    "db:generate": "cd ../.. && prisma generate --schema=apps/server/prisma/schema.prisma",
    "db:push": "cd ../.. && prisma db push --schema=apps/server/prisma/schema.prisma",
    "db:migrate": "cd ../.. && prisma migrate dev --schema=apps/server/prisma/schema.prisma",
    "postinstall": "cd ../.. && prisma generate --schema=apps/server/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.71.0",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.10.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
