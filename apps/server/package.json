{
  "name": "@jobseek/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx tsc",
    "start": "node dist/index.js",
    "worker": "tsx src/workers/job.processor.ts",
    "worker:ats-endpoint": "tsx src/workers/atsEndpoint.processor.ts",
    "scheduler:ats-endpoint": "tsx src/modules/atsEndpoint/atsEndpoint.scheduler.ts",
    "worker:serp": "tsx src/modules/serp/serp.processor.ts",
    "worker:ats-discovery": "tsx src/modules/atsDiscovery/atsDiscovery.processor.ts",
    "scheduler:ats-discovery": "tsx src/modules/atsDiscovery/atsDiscovery.scheduler.ts",
    "test": "node --import tsx --test src/modules/atsDiscovery/atsUrlParser.phase02.test.ts",
    "worker:enrich": "tsx src/workers/enrich-company.processor.ts",
    "scheduler": "tsx src/modules/crawler/crawler.scheduler.ts",
    "scheduler:serp": "tsx src/modules/serp/serp.scheduler.ts",
    "discovery:worker": "tsx src/workers/discovery.processor.ts",
    "discovery:scheduler": "tsx src/modules/discovery/discovery.scheduler.ts",
    "verify:ats-endpoint": "tsx src/scripts/verifyAtsEndpoint.ts",
    "seed": "tsx scripts/seed.companies.ts",
    "seed:csv": "tsx scripts/seedCompaniesFromCSV.ts",
    "reset:fresh": "tsx scripts/reset.fresh.ts",
    "metrics": "tsx src/scripts/metrics.snapshot.ts",
    "metrics:ats": "tsx src/scripts/ats.metrics.snapshot.ts",
    "debug:enrichment": "tsx src/scripts/debug.enrichmentSnapshot.ts",
    "backfill:parsed-descriptions": "tsx src/scripts/backfillParsedDescriptions.ts",
    "backfill:job-enrichment": "tsx src/scripts/backfillJobEnrichment.ts",
    "debug:job-parser": "tsx src/scripts/debugJobParser.ts",
    "augment:training-db": "tsx src/scripts/augmentTrainingDataFromDb.ts",
    "augment:training-recent": "tsx src/scripts/augmentTrainingDataFromDb.ts --append --jobs=8000",
    "clean:training-data": "tsx src/scripts/cleanTrainingData.ts",
    "db:generate": "cd ../.. && prisma generate --schema=apps/server/prisma/schema.prisma",
    "db:push": "cd ../.. && prisma db push --schema=apps/server/prisma/schema.prisma",
    "db:migrate": "cd ../.. && prisma migrate dev --schema=apps/server/prisma/schema.prisma",
    "db:reset": "cd ../.. && prisma migrate reset --schema=apps/server/prisma/schema.prisma",
    "postinstall": "cd ../.. && prisma generate --schema=apps/server/prisma/schema.prisma"
  },
  "dependencies": {
    "@clerk/backend": "^1.34.0",
    "@clerk/nextjs": "^6.39.1",
    "@fastify/cors": "^8.5.0",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.14.0",
    "bullmq": "^5.71.0",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "fastify-raw-body": "^4.3.0",
    "he": "^1.2.0",
    "i18n-iso-countries": "^7.14.0",
    "ioredis": "^5.10.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "rotating-file-stream": "^3.2.9"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
