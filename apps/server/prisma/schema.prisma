generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum CompanyStatus {
  raw
  enriching
  ready
  failed
}

enum CompanyCrawlPriority {
  high
  medium
  low
}

enum EmailFrequency {
  daily
  weekly
  off
}

enum GrowthEmailCampaignType {
  daily_digest
  weekly_digest
  reengagement
  personalized
  event_welcome
  event_followup
  event_saved_search_suggestions
}

enum GrowthEmailSendStatus {
  sent
  skipped
  failed
}

enum SubscriptionProvider {
  paypal
  dodo
}

enum EmailJobSendChannel {
  saved_search_alert
  growth_email
}

model Company {
  id                  String                @id @default(uuid())
  name                String
  slug                String                @unique
  domain              String?               @unique
  logoUrl             String?
  careersUrl          String?
  atsBoardToken       String?
  atsType             String?
  status              CompanyStatus         @default(raw)
  discoverySource     String?
  enrichmentAttempts  Int                   @default(0)
  lastCrawledAt         DateTime?
  score                 Int                   @default(0)
  priority              CompanyCrawlPriority  @default(low)
  lastIngestionSuccessAt DateTime?
  ingestionAttempts     Int                   @default(0)
  lastAttemptAt         DateTime?
  canonicalJobsLast7d   Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  jobs                  Job[]
  atsEndpoints          AtsEndpoint[]

  @@index([priority, score])
  @@index([lastAttemptAt])
}

model AtsEndpoint {
  id             String    @id @default(uuid())
  type           String
  slug           String
  baseUrl        String
  companyName    String?
  companyId      String?
  isActive       Boolean   @default(true)
  lastCheckedAt  DateTime?
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  /// Last time ingest worker completed a crawl + ingest cycle for this endpoint.
  lastCrawledAt  DateTime?
  failureCount   Int       @default(0)
  successCount   Int       @default(0)
  metadata       Json?
  /// Last time endpoint discovery (SERP/jobs) observed this row.
  lastSeenAt     DateTime?
  /// Discovery provenance: "serp" | "job" | "unknown" (e.g. enrichment).
  source         String    @default("unknown")
  score          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([type, slug])
  @@index([companyId])
  @@index([type, isActive])
  @@index([source, score])
}

model Job {
  id                 String    @id @default(uuid())
  title              String
  companyId          String
  /// @deprecated Prefer `locationCountry` after migration; kept for backward compatibility.
  country            String    @default("UNKNOWN")
  locationCity       String?
  locationState      String?
  locationCountry    String    @default("UNKNOWN")
  locationRegion     String?
  isRemote           Boolean   @default(false)
  workType           String    @default("onsite")
  experienceLevel    String?
  category           String    @default("other")
  description        String?   @db.Text
  /// AI / ML structured parse of description (line buckets). Null until worker or backfill runs.
  parsedDescription  Json?
  /// Rule-based signals from parsedDescription (tech stack, salary text, remote hints).
  enriched           Json?
  /// Visibility lifecycle: processing -> ready -> failed.
  status             String    @default("processing")
  source             String
  sourceUrl          String    @unique
  applyUrl           String?
  postedAt           DateTime?
  /// NOTE:
  /// Actual index is a partial index created via raw SQL migration:
  /// idx_jobs_effective_listing_fast
  /// Prisma schema index below is NOT the real query index
  effectivePostedAt  DateTime?
  /// Stored generated: COALESCE(effectivePostedAt, createdAt). Discovery “latest” ORDER BY uses this (matches UI).
  listingFreshnessAt DateTime @default(dbgenerated("(COALESCE(\"effectivePostedAt\", \"createdAt\")) STORED"))
  lastSeenAt         DateTime  @default(now())
  /// Last time downstream discovery/processing consumed this job row.
  lastProcessedAt    DateTime?
  /// Stable hash of normalized title+description+applyUrl to skip unchanged reprocessing.
  contentHash        String?   @db.VarChar(64)
  expiresAt          DateTime?
  isActive           Boolean   @default(true)
  fingerprint        String?
  canonicalJobId     String?
  fingerprintVersion String?
  atsJobId           String?
  freshnessScore     Float     @default(0)
  sourceWeight       Float     @default(0.7)
  role               String    @default("other")
  skills             String[]  @default([])
  salaryMin          Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  canonical  Job?    @relation("JobDuplicates", fields: [canonicalJobId], references: [id], onDelete: Cascade)
  duplicates Job[]   @relation("JobDuplicates")
  applications Application[]
  emailJobSendLogs EmailJobSendLog[]

  @@index([title])
  @@index([companyId])
  @@index([fingerprint])
  @@index([canonicalJobId])
  @@index([expiresAt])
  @@index([isActive, expiresAt])
  @@index([lastSeenAt])
  @@index([lastProcessedAt])
  @@index([contentHash])
  @@index([canonicalJobId, lastSeenAt])
  @@index([freshnessScore])
  @@index([sourceWeight])
  @@index([role])
  @@index([country])
  @@index([locationCountry])
  @@index([locationRegion])
  @@index([category])
  @@index([isRemote])
  @@index([workType])
  @@index([experienceLevel])
  @@index([skills], type: Gin)
  @@index([status])
  @@index([effectivePostedAt])
  @@index([listingFreshnessAt], map: "idx_jobs_listing_freshness_at")
}

model SerpBatch {
  id        String      @id @default(uuid())
  query     String
  source    String
  status    String
  createdAt DateTime    @default(now())

  results   SerpResult[]
}

model SerpResult {
  id       String   @id @default(uuid())
  batchId  String
  url      String
  domain   String   @default("")
  atsType  String?
  slug     String?
  score    Int      @default(0)
  title    String?
  snippet  String?
  rank     Int?
  createdAt DateTime @default(now())
  discoveredAt DateTime?

  batch    SerpBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([url])
  @@index([domain])
  @@index([atsType])
  @@index([score])
  @@index([atsType, score])
  @@index([discoveredAt])
}

model User {
  id                 String         @id @default(uuid())
  clerkId            String         @unique
  email              String         @unique
  plan               String         @default("free") // "free" | "pro" (legacy "pro_plus" treated as Pro in app)
  stripeCustomerId   String?        @unique
  jobViewsToday      Int            @default(0)
  jobViewsResetAt    DateTime       @default(now())
  resumeText           String?      // parsed plain text
  resumeFileKey        String?      // object storage key for resume bytes
  resumeFileName       String?      // original filename
  resumeFileSize       Int?         // object size in bytes
  resumeFileData       Bytes?       // raw file bytes for download
  resumeUpdatedAt      DateTime?
  resumeContentHash    String?      // sha256 of normalized text; scoring/debug
  resumeBullets        Json?        // String[] of extracted bullet points
  resumeBulletEmbeddings Json?      // number[][] parallel array of embeddings
  resumeStructuredV1   Json?        // deterministic structured extraction payload
  profileExtractLastAt DateTime?    // last POST extract-profile (1/day UTC limit)
  // Apply profile
  firstName              String?
  lastName               String?
  phone                  String?
  address                String?
  city                   String?
  country                String?
  linkedinUrl            String?
  githubUrl              String?
  portfolioUrl           String?
  workAuthorization      String?
  // "citizen" | "permanent_resident" | "visa_required" | "other"
  salaryExpectation      String?
  currentCompensation    String?    // current pay — forms; rarely on resume
  availableFrom          String?
  noticePeriod           String?
  relocationPreference   String?
  remotePreference       String?    // remote | hybrid | onsite | no_preference
  yearsOfExperience      Int?
  currentTitle           String?
  currentCompany         String?
  professionalSummary    String?
  languages              String?    // comma-separated or free text
  certifications         String?
  highestEducation       String?
  customQA               Json?
  // Array<{ question: string, answer: string }>
  applyProfileSummary    Json?
  smartApplyPreferences  Json?      // { tone, length, firstPerson } answer style
  applyProfileExtras     Json?      // long-tail form fields
  // Compact extracted profile for AI prompts
  // Smart Apply usage tracking
  smartApplyEnabled      Boolean   @default(false)
  smartApplyJobsToday    Int       @default(0)
  smartApplyResetAt      DateTime  @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  subscription       Subscription?
  savedSearches      SavedSearch[]
  applications       Application[]
  emailPreference    EmailPreference?
  growthEmailSends   GrowthEmailSend[]
  emailJobSendLogs   EmailJobSendLog[]
}

model EmailPreference {
  id                    String         @id @default(uuid())
  userId                String         @unique
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketingEnabled      Boolean        @default(true)
  frequency             EmailFrequency @default(daily)
  source                String?        @default("signup_default")
  lastActiveAt          DateTime?
  lastGrowthEmailSentAt DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([marketingEnabled, frequency])
  @@index([lastGrowthEmailSentAt])
  @@index([lastActiveAt])
}

model EmailLead {
  id                    String              @id @default(uuid())
  email                 String              @unique
  source                String
  context               Json?
  marketingEnabled      Boolean             @default(true)
  frequency             EmailFrequency      @default(daily)
  lastGrowthEmailSentAt DateTime?
  unsubscribedAt        DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  growthEmailSends      EmailLeadGrowthSend[]

  @@index([marketingEnabled, frequency])
  @@index([lastGrowthEmailSentAt])
}

model EmailLeadGrowthSend {
  id                String                  @id @default(uuid())
  emailLeadId       String
  emailLead         EmailLead               @relation(fields: [emailLeadId], references: [id], onDelete: Cascade)
  campaignType      GrowthEmailCampaignType
  periodKey         String
  status            GrowthEmailSendStatus   @default(sent)
  providerMessageId String?
  subjectUsed       String?
  jobCountSent      Int                     @default(0)
  sentAt            DateTime?
  error             String?
  createdAt         DateTime                @default(now())

  @@unique([emailLeadId, campaignType, periodKey])
  @@index([emailLeadId, createdAt])
}

model GrowthEmailSend {
  id                String                  @id @default(uuid())
  userId            String
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignType      GrowthEmailCampaignType
  periodKey         String
  status            GrowthEmailSendStatus   @default(sent)
  providerMessageId String?
  subjectUsed       String?
  jobCountSent      Int                     @default(0)
  sentAt            DateTime?
  error             String?
  createdAt         DateTime                @default(now())
  emailJobLogs      EmailJobSendLog[]

  @@unique([userId, campaignType, periodKey])
  @@index([userId, createdAt])
}

model EmailJobSendLog {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String
  job          Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  channel      EmailJobSendChannel
  growthSendId String?
  growthSend   GrowthEmailSend?    @relation(fields: [growthSendId], references: [id], onDelete: SetNull)
  sentAt       DateTime            @default(now())
  createdAt    DateTime            @default(now())

  @@index([userId, sentAt])
  @@index([userId, jobId, sentAt])
  @@index([growthSendId])
}

model Application {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status         String   @default("applied")
  /// "applied" | "acknowledged" | "assessment" | "interview" | "offer" | "rejected" | "archived"
  appliedAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  notes          String?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
  @@index([userId, archived])
}

model Subscription {
  id                   String               @id @default(uuid())
  userId               String               @unique
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             SubscriptionProvider @default(paypal)
  paypalId             String?              @unique
  dodoSubscriptionId   String?              @unique
  stripeCustomerId     String?              @unique
  stripePriceId        String?
  stripeSubscriptionId String?  @unique
  status               String // "active" | "canceled" | "past_due"
  currentPeriodEnd     DateTime
  graceEndsAt          DateTime?
  lastEventAt          DateTime?
  lastEventType        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ProcessedWebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  createdAt DateTime @default(now())
}

model SavedSearch {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String?
  query           String
  alertEnabled    Boolean   @default(false)
  alertThreshold  Int       @default(5)
  alertLastSentAt DateTime?
  alertJobsSeen   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([alertEnabled])
  @@unique([userId, query])
}
