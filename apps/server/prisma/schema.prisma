generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  raw
  enriching
  ready
  failed
}

model Company {
  id                  String         @id @default(uuid())
  name                String
  slug                String         @unique
  domain              String?        @unique
  logoUrl             String?
  careersUrl          String?
  atsBoardToken       String?
  atsType             String?
  status              CompanyStatus  @default(raw)
  discoverySource     String?
  enrichmentAttempts  Int            @default(0)
  lastCrawledAt         DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  jobs                  Job[]
  atsEndpoints          AtsEndpoint[]
}

model AtsEndpoint {
  id             String    @id @default(uuid())
  type           String
  slug           String
  baseUrl        String
  companyName    String?
  companyId      String?
  isActive       Boolean   @default(true)
  lastCheckedAt  DateTime?
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  /// Last time ingest worker completed a crawl + ingest cycle for this endpoint.
  lastCrawledAt  DateTime?
  failureCount   Int       @default(0)
  successCount   Int       @default(0)
  metadata       Json?
  /// Last time endpoint discovery (SERP/jobs) observed this row.
  lastSeenAt     DateTime?
  /// Discovery provenance: "serp" | "job" | "unknown" (e.g. enrichment).
  source         String    @default("unknown")
  score          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([type, slug])
  @@index([companyId])
  @@index([type, isActive])
  @@index([source, score])
}

model Job {
  id                 String    @id @default(uuid())
  title              String
  companyId          String
  /// @deprecated Prefer `locationCountry` after migration; kept for backward compatibility.
  country            String    @default("UNKNOWN")
  locationCity       String?
  locationState      String?
  locationCountry    String    @default("UNKNOWN")
  locationRegion     String?
  isRemote           Boolean   @default(false)
  workType           String    @default("onsite")
  experienceLevel    String?
  category           String    @default("other")
  description        String?   @db.Text
  /// AI / ML structured parse of description (line buckets). Null until worker or backfill runs.
  parsedDescription  Json?
  /// Rule-based signals from parsedDescription (tech stack, salary text, remote hints).
  enriched           Json?
  /// Visibility lifecycle: processing -> ready -> failed.
  status             String    @default("processing")
  source             String
  sourceUrl          String    @unique
  applyUrl           String?
  postedAt           DateTime?
  lastSeenAt         DateTime  @default(now())
  expiresAt          DateTime?
  isActive           Boolean   @default(true)
  fingerprint        String?
  canonicalJobId     String?
  fingerprintVersion String?
  atsJobId           String?
  freshnessScore     Float     @default(0)
  sourceWeight       Float     @default(0.7)
  role               String    @default("other")
  skills             String[]  @default([])
  salaryMin          Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  canonical  Job?    @relation("JobDuplicates", fields: [canonicalJobId], references: [id], onDelete: Cascade)
  duplicates Job[]   @relation("JobDuplicates")
  applications Application[]

  @@index([title])
  @@index([companyId])
  @@index([fingerprint])
  @@index([canonicalJobId])
  @@index([expiresAt])
  @@index([isActive, expiresAt])
  @@index([lastSeenAt])
  @@index([canonicalJobId, lastSeenAt])
  @@index([freshnessScore])
  @@index([sourceWeight])
  @@index([role])
  @@index([country])
  @@index([locationCountry])
  @@index([locationRegion])
  @@index([category])
  @@index([isRemote])
  @@index([workType])
  @@index([experienceLevel])
  @@index([skills], type: Gin)
  @@index([status])
}

model SerpBatch {
  id        String      @id @default(uuid())
  query     String
  source    String
  status    String
  createdAt DateTime    @default(now())

  results   SerpResult[]
}

model SerpResult {
  id       String   @id @default(uuid())
  batchId  String
  url      String
  domain   String   @default("")
  atsType  String?
  slug     String?
  score    Int      @default(0)
  title    String?
  snippet  String?
  rank     Int?
  createdAt DateTime @default(now())
  discoveredAt DateTime?

  batch    SerpBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([url])
  @@index([domain])
  @@index([atsType])
  @@index([score])
  @@index([atsType, score])
  @@index([discoveredAt])
}

model User {
  id                 String         @id @default(uuid())
  clerkId            String         @unique
  email              String         @unique
  plan               String         @default("free") // "free" | "pro" (legacy "pro_plus" treated as Pro in app)
  stripeCustomerId   String?        @unique
  jobViewsToday      Int            @default(0)
  jobViewsResetAt    DateTime       @default(now())
  /// Discovery list (GET /jobs): 0–2 "searches" per UTC day, then optional bonus batch.
  discoverySearchesToday Int      @default(0)
  discoveryBonusFiveUsed Boolean  @default(false)
  resumeText           String?      // parsed plain text
  resumeFileKey        String?      // object storage key for resume bytes
  resumeFileName       String?      // original filename
  resumeFileSize       Int?         // object size in bytes
  resumeFileData       Bytes?       // raw file bytes for download
  resumeUpdatedAt      DateTime?
  resumeContentHash    String?      // sha256 of normalized text; scoring/debug
  resumeBullets        Json?        // String[] of extracted bullet points
  resumeBulletEmbeddings Json?      // number[][] parallel array of embeddings
  resumeStructuredV1   Json?        // deterministic structured extraction payload
  profileExtractLastAt DateTime?    // last POST extract-profile (1/day UTC limit)
  // Apply profile
  firstName              String?
  lastName               String?
  phone                  String?
  address                String?
  city                   String?
  country                String?
  linkedinUrl            String?
  githubUrl              String?
  portfolioUrl           String?
  workAuthorization      String?
  // "citizen" | "permanent_resident" | "visa_required" | "other"
  salaryExpectation      String?
  currentCompensation    String?    // current pay — forms; rarely on resume
  availableFrom          String?
  noticePeriod           String?
  relocationPreference   String?
  remotePreference       String?    // remote | hybrid | onsite | no_preference
  yearsOfExperience      Int?
  currentTitle           String?
  currentCompany         String?
  professionalSummary    String?
  languages              String?    // comma-separated or free text
  certifications         String?
  highestEducation       String?
  customQA               Json?
  // Array<{ question: string, answer: string }>
  applyProfileSummary    Json?
  smartApplyPreferences  Json?      // { tone, length, firstPerson } answer style
  applyProfileExtras     Json?      // long-tail form fields
  // Compact extracted profile for AI prompts
  // Smart Apply usage tracking
  smartApplyEnabled      Boolean   @default(false)
  smartApplyJobsToday    Int       @default(0)
  smartApplyResetAt      DateTime  @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  subscription       Subscription?
  savedSearches      SavedSearch[]
  applications       Application[]
}

model Application {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status         String   @default("applied")
  /// "applied" | "acknowledged" | "assessment" | "interview" | "offer" | "rejected" | "archived"
  appliedAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  notes          String?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
  @@index([userId, archived])
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String   @unique
  stripePriceId        String
  stripeSubscriptionId String   @unique
  status               String // "active" | "canceled" | "past_due"
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SavedSearch {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String?
  query           String
  alertEnabled    Boolean   @default(false)
  alertThreshold  Int       @default(5)
  alertLastSentAt DateTime?
  alertJobsSeen   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([alertEnabled])
  @@unique([userId, query])
}
